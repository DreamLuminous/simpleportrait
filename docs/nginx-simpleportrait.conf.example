# SimplePortrait v0.2.1 static-site routing example
# Merge the location rules into the server block generated for the site.

location / {
    try_files $uri $uri/ $uri/index.html =404;
}

location /_next/static/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
}
